apiVersion: ray.io/v1
kind: RayCluster
metadata:
  name: verl-cluster
  namespace: ${NAMESPACE}
spec:
  rayVersion: '2.47.1'
  headGroupSpec:
    rayStartParams:
      # Per-engine (ENGINE_HEAD_NUM_CPUS in deploy.env). vLLM: "4", so the driver can
      # land here - the head has the RAM for the dataloader and the validation batch.
      # SGLang: "0", so Ray never schedules a generic actor here - importing
      # SGLangReplica needs libcuda.so.1 and crashes on this GPU-less node. EPP is
      # unaffected either way: LlmdActor pins itself with NodeAffinity, not CPU
      # scheduling, and asks for num_cpus=0.
      num-cpus: "${ENGINE_HEAD_NUM_CPUS}"
    template:
      spec:
        # Co-locate the head with the worker so EPP/Envoy routing stays on-node.
        # One-directional (head -> worker) to avoid a scheduling deadlock.
        affinity:
          podAffinity:
            requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  ray.io/cluster: verl-cluster
                  ray.io/node-type: worker
              topologyKey: kubernetes.io/hostname
        # EPP and Envoy are not in the verl image: this init container extracts them
        # from their own images into llm-d-bins. To change either, bump its tag in
        # deploy.env and recreate the pod (push-epp.sh is the faster EPP loop).
        initContainers:
        - name: fetch-binaries
          # Generic registry tool pinned by digest (go-containerregistry crane
          # :debug, which ships /busybox/sh + /busybox/tar). Never rebuilt.
          image: ${IMG_CRANE}
          command: ["/busybox/sh", "-c"]
          args:
          - |
            set -e
            /ko-app/crane export --platform linux/amd64 "$EPP_IMAGE"   - | /busybox/tar -xOf - app/epp             > /opt/llm-d-bins/epp
            /ko-app/crane export --platform linux/amd64 "$ENVOY_IMAGE" - | /busybox/tar -xOf - usr/local/bin/envoy > /opt/llm-d-bins/envoy
            chmod +x /opt/llm-d-bins/epp /opt/llm-d-bins/envoy
          env:
          # Bump these tags (in deploy/deploy.env) to change the EPP / Envoy
          # version a recreated pod boots with. Must be anonymously-pullable
          # (public) images.
          - name: EPP_IMAGE
            value: "${IMG_EPP}"
          - name: ENVOY_IMAGE
            value: "${IMG_ENVOY}"
          volumeMounts:
          - mountPath: /opt/llm-d-bins
            name: llm-d-bins
        containers:
        - name: ray-head
          image: ${IMG_TRAINER} # engine-selected env image (IMG_VERL / IMG_VERL_SGLANG); one image covers native/epp/epp-p2p/PD
          imagePullPolicy: Always
          lifecycle:
            postStart:
              exec:
                command:
                - /bin/bash
                - -c
                - |
                  exec > /tmp/setup_log.txt 2>&1
                  set -euo pipefail
                  echo "Starting setup..."

                  # PEP 668: the vLLM env image sets this in its own Dockerfile, the stock
                  # verlai/verl:sgl* image does not, and Ubuntu 24.04 blocks system-wide pip
                  # installs without it. Harmless where it is already set.
                  export PIP_BREAK_SYSTEM_PACKAGES=1

                  # Install verl at the ref from deploy.env's VERL_COMMIT. Echo the
                  # resolved SHA: with a branch ref, head and workers clone at different
                  # times and can land on different commits.
                  git clone https://github.com/volcengine/verl.git /tmp/verl/verl
                  cd /tmp/verl/verl && git checkout '${VERL_COMMIT}'
                  echo "verl at $(git rev-parse HEAD) (requested '${VERL_COMMIT}')"
                  pip install --no-deps -e /tmp/verl/verl

                  # Common package first (the verl package depends on it). The import
                  # checks make a silent empty install a hard postStart failure.
                  pip install --no-deps --no-cache-dir --force-reinstall "git+https://github.com/llm-d-incubation/llm-d-rl.git#subdirectory=integrations/common"
                  python3 -c "import llm_d_rl_common" || { echo "FATAL: common package not importable after install"; exit 1; }
                  pip install --no-deps --no-cache-dir --force-reinstall "git+https://github.com/llm-d-incubation/llm-d-rl.git#subdirectory=integrations/verl"
                  python3 -c "import llm_d_rl_verl_integration" || { echo "FATAL: integration package not importable after install"; exit 1; }
                  python3 -c "import ${ENGINE_PY_MODULE}" || { echo "FATAL: ${ENGINE_PY_MODULE} not importable - wrong image for this engine?"; exit 1; }

                  # Prepare data and prefetch the model.
                  mkdir -p /tmp/verl/hf_cache/datasets

                  # Pre-fetch model weights (tokenizer/config only on head)
                  # flock: head and worker prefetch into the SAME PVC directory now, so
                  # serialise them - huggingface_hub renames atomically but would
                  # otherwise download the shared small files twice on a cold PVC.
                  flock /tmp/verl/models/.hf-prefetch.lock python3 -c "
                  from huggingface_hub import snapshot_download
                  snapshot_download('Qwen/Qwen3-4B', local_dir='/tmp/verl/models/Qwen3-4B',
                      ignore_patterns=['*.safetensors', '*.bin', '*.pt'],
                      local_dir_use_symlinks=False)
                  "
                  echo "Setup complete" > /tmp/verl_ready.txt
          env:
          # --- Runtime paths ---
          - name: HOME
            value: "/tmp"

          # --- HuggingFace cache ---
          - name: HF_HOME
            value: "/tmp/verl/hf_cache"
          - name: HF_DATASETS_CACHE
            value: "/tmp/verl/hf_cache/datasets"
          - name: XDG_CACHE_HOME
            value: "/tmp/verl/hf_cache"
          - name: HUGGINGFACE_HUB_CACHE
            value: "/tmp/verl/hf_cache"

          # --- Compile / framework caches ---
          - name: TRITON_CACHE_DIR
            value: "/tmp/triton"
          - name: FLASHINFER_WORKSPACE_DIR
            value: "/tmp/flashinfer"

          # --- Experiment tracking ---
          - name: WANDB_MODE
            value: "offline"

          # --- verl logging ---
          - name: VERL_LOGGING_LEVEL
            value: "INFO"
          - name: VERL_FILE_LOGGER_ROOT
            value: "/tmp/verl/logs"

          # --- EPP / Envoy binary paths (from the fetch-binaries init container) ---
          - name: VERL_EPP_BINARY
            value: "/opt/llm-d-bins/epp"
          - name: VERL_ENVOY_BINARY
            value: "/opt/llm-d-bins/envoy"

          # --- vLLM / Ray settings ---
          # PYTHONHASHSEED must be pinned fleet-wide or P2P block hashes never match.
          - name: PYTHONHASHSEED
            value: "0"
          - name: VLLM_USE_V1
            value: "1"
          - name: TOKENIZERS_PARALLELISM
            value: "false"
          - name: OMP_NUM_THREADS
            value: "1"

          # --- NCCL ---
          - name: NCCL_DEBUG
            value: "INFO"

          # --- llm-d integration debug logging (default: quiet) ---
          # Uncomment to enable verbose output from integration components.
          # See README ## Debug logging for details.
          # - name: VERL_VLLM_LOG_LEVEL
          #   value: "DEBUG"
          # - name: VERL_SIDECAR_LOG_LEVEL
          #   value: "5"
          # - name: VERL_EPP_VERBOSITY
          #   value: "5"
          # - name: VERL_ENVOY_LOG_LEVEL
          #   value: "debug"

          resources:
            limits:
              cpu: "32"
              # The driver collects a whole validation batch here; multimodal tasks
              # need the headroom.
              memory: "512G"
              # No GPU on head - it only runs the driver (fit() loop) and Ray GCS.
              # FSDP training and NCCL broadcast happen on worker pods.
            requests:
              cpu: "24"
              memory: "256G"
          ports:
          - containerPort: 6379
            name: gcs-server
          - containerPort: 8265
            name: dashboard
          - containerPort: 10001
            name: client
          - containerPort: 8081
            name: envoy
          volumeMounts:
          # Writable (not readOnly): push-epp.sh kubectl-cp's into here at runtime.
          - mountPath: /opt/llm-d-bins
            name: llm-d-bins
          - mountPath: /dev/shm
            name: dshm
          - mountPath: /etc/llmd-configs
            name: llmd-epp-configs
            readOnly: true
          # Durable cache (PVC): HF checkpoints and built parquet datasets survive a pod
          # recreate. Mounted AT the paths everything already uses, via subPath, so the
          # 91 references to /tmp/verl/{models,data,hf_cache} across the workloads need
          # no change - "fetch if missing, then reuse" is just snapshot_download's and
          # make_*.py's existing behaviour, now landing on durable storage.
          - mountPath: /tmp/verl/models
            name: verl-cache
            subPath: models
          - mountPath: /tmp/verl/data
            name: verl-cache
            subPath: data
          - mountPath: /tmp/verl/hf_cache
            name: verl-cache
            subPath: hf_cache
        volumes:
        - name: dshm
          emptyDir:
            medium: Memory
            sizeLimit: "32Gi"
        - name: llmd-epp-configs
          configMap:
            name: llmd-epp-configs
        - name: verl-cache
          persistentVolumeClaim:
            claimName: verl-cache
        # Shared scratch for the EPP/Envoy binaries; starts empty on a fresh pod.
        - name: llm-d-bins
          emptyDir: {}

  workerGroupSpecs:
  # GPU workers: the worker pod's nvidia.com/gpu request must match the GPU count the
  # run command targets (NGPUS_PER_NODE). As shipped the 4-GPU option below is active
  # (Option A 8-GPU is commented out); enable whichever matches your run.
  # Raise replicas/maxReplicas only if you add nodes and adjust verl nnodes / n_gpus_per_node.
  - groupName: fsdp-workers
    replicas: 1
    minReplicas: 1
    maxReplicas: 1
    rayStartParams:
      num-cpus: "48"   # limit Ray's visible CPUs to reduce internal thread spawning
    template:
      spec:
        # No node pinning: the GPU request anchors this worker and the head follows.
        # Do not add affinity back to the head - mutual required affinity deadlocks.
        # Extracts the pd-sidecar binary into llm-d-bins for the replicas to launch
        # (VERL_SIDECAR_BINARY). Bump the tag in deploy.env and recreate to change.
        initContainers:
        - name: fetch-sidecar
          # Generic registry tool pinned by digest (go-containerregistry crane
          # :debug, which ships /busybox/sh + /busybox/tar). Never rebuilt.
          image: ${IMG_CRANE}
          command: ["/busybox/sh", "-c"]
          args:
          - |
            set -e
            /ko-app/crane export --platform linux/amd64 "$SIDECAR_IMAGE" - | /busybox/tar -xOf - app/pd-sidecar > /opt/llm-d-bins/pd-sidecar
            chmod +x /opt/llm-d-bins/pd-sidecar
          env:
          # Bump this tag (in deploy/deploy.env) to change the sidecar version a
          # recreated pod boots with. Must be an anonymously-pullable (public) image.
          - name: SIDECAR_IMAGE
            value: "${IMG_SIDECAR}"
          volumeMounts:
          - mountPath: /opt/llm-d-bins
            name: llm-d-bins
        containers:
        - name: ray-worker
          image: ${IMG_TRAINER} # engine-selected env image (IMG_VERL / IMG_VERL_SGLANG); one image covers native/epp/epp-p2p/PD
          imagePullPolicy: Always
          lifecycle:
            postStart:
              exec:
                command:
                - /bin/bash
                - -c
                - |
                  exec > /tmp/setup_log.txt 2>&1
                  set -euo pipefail
                  # PEP 668: the vLLM env image sets this in its own Dockerfile, the stock
                  # verlai/verl:sgl* image does not, and Ubuntu 24.04 blocks system-wide pip
                  # installs without it. Harmless where it is already set.
                  export PIP_BREAK_SYSTEM_PACKAGES=1

                  # Install verl at the ref from deploy.env's VERL_COMMIT. Echo the
                  # resolved SHA: with a branch ref, head and workers clone at different
                  # times and can land on different commits.
                  git clone https://github.com/volcengine/verl.git /tmp/verl/verl
                  cd /tmp/verl/verl && git checkout '${VERL_COMMIT}'
                  echo "verl at $(git rev-parse HEAD) (requested '${VERL_COMMIT}')"
                  pip install --no-deps -e /tmp/verl/verl

                  # Common package first (the verl package depends on it). The import
                  # checks make a silent empty install a hard postStart failure.
                  pip install --no-deps --no-cache-dir --force-reinstall "git+https://github.com/llm-d-incubation/llm-d-rl.git#subdirectory=integrations/common"
                  python3 -c "import llm_d_rl_common" || { echo "FATAL: common package not importable after install"; exit 1; }
                  pip install --no-deps --no-cache-dir --force-reinstall "git+https://github.com/llm-d-incubation/llm-d-rl.git#subdirectory=integrations/verl"
                  python3 -c "import llm_d_rl_verl_integration" || { echo "FATAL: integration package not importable after install"; exit 1; }
                  python3 -c "import ${ENGINE_PY_MODULE}" || { echo "FATAL: ${ENGINE_PY_MODULE} not importable - wrong image for this engine?"; exit 1; }
                  mkdir -p /tmp/verl/hf_cache/datasets
                  # Full model weights for FSDP training + vLLM rollout
                  # flock: head and worker prefetch into the SAME PVC directory now, so
                  # serialise them - huggingface_hub renames atomically but would
                  # otherwise download the shared small files twice on a cold PVC.
                  flock /tmp/verl/models/.hf-prefetch.lock python3 -c "
                  from huggingface_hub import snapshot_download
                  snapshot_download('Qwen/Qwen3-4B', local_dir='/tmp/verl/models/Qwen3-4B',
                      local_dir_use_symlinks=False)
                  "
                  echo "Setup complete" > /tmp/verl_ready.txt
          env:
          # --- Runtime paths ---
          - name: HOME
            value: "/tmp"

          # --- HuggingFace cache ---
          - name: HF_HOME
            value: "/tmp/verl/hf_cache"
          - name: HF_DATASETS_CACHE
            value: "/tmp/verl/hf_cache/datasets"
          - name: XDG_CACHE_HOME
            value: "/tmp/verl/hf_cache"
          - name: HUGGINGFACE_HUB_CACHE
            value: "/tmp/verl/hf_cache"

          # --- Compile / framework caches ---
          - name: TRITON_CACHE_DIR
            value: "/tmp/triton"

          # --- Experiment tracking ---
          - name: WANDB_MODE
            value: "offline"

          # --- verl logging ---
          - name: VERL_LOGGING_LEVEL
            value: "INFO"

          # --- Sidecar binary path (filled by the fetch-sidecar init container) ---
          # The sidecar is not baked into the verl image; fetch-sidecar extracts it
          # from the separate sidecar image into /opt/llm-d-bins. Decode replicas
          # launch whatever binary is here (PD mode only).
          - name: VERL_SIDECAR_BINARY
            value: "/opt/llm-d-bins/pd-sidecar"

          # --- vLLM / Ray settings ---
          # PYTHONHASHSEED must be pinned fleet-wide or P2P block hashes never match.
          - name: PYTHONHASHSEED
            value: "0"
          - name: VLLM_USE_V1
            value: "1"
          - name: PYTORCH_CUDA_ALLOC_CONF
            # vLLM: "expandable_segments:False" - CuMemAllocator (sleep/wake) is
            # incompatible with expandable_segments. SGLang: empty, which torch parses
            # as no options. ENGINE_ALLOC_CONF in deploy.env.
            value: "${ENGINE_ALLOC_CONF}"
          - name: TOKENIZERS_PARALLELISM
            value: "false"
          - name: OMP_NUM_THREADS
            value: "1"
          - name: RAY_max_grpc_threads
            value: "32"

          # --- NCCL ---
          - name: NCCL_DEBUG
            value: "INFO"

          # --- llm-d integration debug logging (default: quiet) ---
          # Uncomment to enable verbose output from integration components.
          # See README ## Debug logging for details.
          # - name: VERL_VLLM_LOG_LEVEL
          #   value: "DEBUG"
          # - name: VERL_SIDECAR_LOG_LEVEL
          #   value: "5"
          # - name: VERL_EPP_VERBOSITY
          #   value: "5"
          # - name: VERL_ENVOY_LOG_LEVEL
          #   value: "debug"

          resources:
            limits:
            # --- Option A: 8 GPUs ---
              cpu: "64"
              # 1200G: the 8-rank FSDP actor + vLLM replicas + ref peak at ~250-256G of
              # host RAM, AND the dshm tmpfs below is charged to this same cgroup - at
              # cpu_bytes_to_use=72GiB x 8 replicas that is another 576GiB. A ceiling,
              # not a reservation: requests stay at 256G. Node allocatable is ~2014GiB
              # and every other pod on a GPU node here is a DaemonSet (~112GiB).
              memory: "1200G"
              nvidia.com/gpu: "8"
            requests:
              cpu: "48"
              memory: "256G"
              nvidia.com/gpu: "8"
            # --- Option B: 4 GPUs ---
            #  cpu: "32"
            #  memory: "128G"
            #  nvidia.com/gpu: "4"
            #requests:
            #  cpu: "16"
            #  memory: "96G"
            #  nvidia.com/gpu: "4"
          volumeMounts:
          - mountPath: /opt/llm-d-bins
            name: llm-d-bins
          - mountPath: /dev/shm
            name: dshm
          - mountPath: /etc/llmd-configs
            name: llmd-epp-configs
            readOnly: true
          # Durable cache (PVC): HF checkpoints and built parquet datasets survive a pod
          # recreate. Mounted AT the paths everything already uses, via subPath, so the
          # 91 references to /tmp/verl/{models,data,hf_cache} across the workloads need
          # no change - "fetch if missing, then reuse" is just snapshot_download's and
          # make_*.py's existing behaviour, now landing on durable storage.
          - mountPath: /tmp/verl/models
            name: verl-cache
            subPath: models
          - mountPath: /tmp/verl/data
            name: verl-cache
            subPath: data
          - mountPath: /tmp/verl/hf_cache
            name: verl-cache
            subPath: hf_cache
        volumes:
        # Shared scratch: fetch-sidecar (init) extracts the sidecar binary here and
        # decode replicas read it at /opt/llm-d-bins (VERL_SIDECAR_BINARY). Starts
        # empty on a fresh pod.
        - name: llm-d-bins
          emptyDir: {}
        - name: dshm
          emptyDir:
            medium: Memory
            # /dev/shm holds OffloadingConnector's CPU KV tier, so this caps
            # cpu_bytes_to_use x n_replicas. Counts against the pod memory limit.
            # 640Gi headroom for 8 x 72GiB (PR #2067's "size the CPU tier at least as
            # large as the per-replica GPU KV cache", measured at 67.43GiB). A cap only,
            # so smaller cpu_bytes_to_use values need no manifest change - sweep them
            # with P2P_CPU_BYTES_TO_USE instead. NOTE: a leaked vllm_offload_*.mmap now
            # pins up to 72GiB, so clearing them between runs is mandatory, not hygiene.
            sizeLimit: "640Gi"
        - name: llmd-epp-configs
          configMap:
            name: llmd-epp-configs
        - name: verl-cache
          persistentVolumeClaim:
            claimName: verl-cache
